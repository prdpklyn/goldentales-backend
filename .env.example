# GoldenTales Environment Variables
# ==================================
# Copy this file to .env and fill in your values

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS - Allowed origins (comma-separated for multiple)
# In development, all origins are allowed regardless of this setting
# In production, ONLY these origins are allowed
CORS_ORIGINS=["https://goldentales.app","http://localhost:3000","http://localhost:5173"]

# ============================================
# AI Services (REQUIRED)
# ============================================

# Fal.ai - Image generation
# Get key at: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Google Gemini - Story generation
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ============================================
# Supabase Database (REQUIRED)
# ============================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (for client-side operations)
# Found in: Supabase Dashboard > Settings > API > anon key
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Shopify Integration (Required for orders)
# ============================================

# Your Shopify store URL
SHOPIFY_STORE_URL=your-store.myshopify.com

# Admin API access token
# Create a private app or custom app in Shopify Admin
SHOPIFY_ACCESS_TOKEN=shpat_xxxxx

# Webhook secret for HMAC verification
# Found in Shopify Admin > Settings > Notifications > Webhooks
SHOPIFY_WEBHOOK_SECRET=whsec_xxxxx

# ============================================
# Security & Authentication
# ============================================

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# API Key Authentication
# Set to true to require API keys even in development
API_KEY_REQUIRED=false

# Development API key (only used if API_KEY_REQUIRED=true in dev)
# Generate with: python -c "import secrets; print(f'gt_{secrets.token_urlsafe(32)}')"
DEV_API_KEY=gt_development_key_change_in_production

# Redis (for production rate limiting and caching)
# If not set, uses in-memory rate limiting
REDIS_URL=redis://localhost:6379/0

# ============================================
# Fulfillment (Choose one or both)
# ============================================

# Printful - Print on demand fulfillment
# Get key at: https://www.printful.com/dashboard/developers
PRINTFUL_API_KEY=your_printful_key_here

# Lulu - Print on demand fulfillment (alternative)
# Get key at: https://developers.lulu.com/
LULU_API_KEY=your_lulu_key_here

# ============================================
# Optional Services
# ============================================

# Stripe - Payment processing
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx

# SendGrid - Email delivery (for digital orders)
# Get key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxx

# ============================================
# Pricing (USD)
# ============================================

PRICE_DIGITAL=9.99
PRICE_SOFTCOVER=24.99
PRICE_HARDCOVER=34.99
SHIPPING_STANDARD=5.99
SHIPPING_EXPRESS=14.99
GIFT_WRAP_COST=5.00

# ============================================
# Timeline Configuration
# ============================================

CHRISTMAS_YEAR=2024
STANDARD_SHIPPING_DAYS=10
EXPRESS_SHIPPING_DAYS=4

# Frontend URL (for emails, redirects, etc.)
FRONTEND_URL=https://goldentales.app
